{
  "schemaVersion": 1,
  "language": "es-MX",
  "purpose": "Escenarios conversacionales reservados para validación manual y futura memoria contextual; no se incorporan al entrenamiento ni a las métricas del clasificador de un solo turno.",
  "scenarios": [
    {
      "id": "saldo_a_habitos",
      "turns": [
        {
          "turn": 1,
          "role": "user",
          "text": "¿Cuántas monedas llevo?",
          "expectedIntent": "consultar_saldo"
        },
        {
          "turn": 2,
          "role": "user",
          "text": "Quiero agregar un hábito",
          "expectedIntent": "agregar_habito"
        },
        {
          "turn": 3,
          "role": "user",
          "text": "Uno de caminar",
          "expectedIntent": "ambiguo_necesita_aclaracion"
        }
      ]
    },
    {
      "id": "cuenta_no_habito",
      "turns": [
        {
          "turn": 1,
          "role": "user",
          "text": "Quiero borrar mi cuenta",
          "expectedIntent": "eliminar_cuenta"
        },
        {
          "turn": 2,
          "role": "user",
          "text": "¿Eso elimina mis registros?",
          "expectedIntent": "ambiguo_necesita_aclaracion"
        }
      ]
    },
    {
