rules_version = '2';

// Laboratorio aislado: NUNCA desplegar en el proyecto Firebase real.
// El cliente no puede validar que la fotografía pruebe un hábito.
// Estos archivos NO acreditan XP, monedas ni progreso.
service firebase.storage {
  match /b/{bucket}/o {
    match /habit-evidence/{uid}/{attemptId}/{evidenceId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validId(id) {
        return id.matches('^[A-Za-z0-9_-]{16,128}$');
      }
      allow get: if isOwner();
      allow list: if false;
      // Únicamente Admin SDK, tras validar la reserva en Functions Emulator.
      // Ni siquiera el propietario puede crear archivos directamente.
      allow create: if false;
      allow update: if false;
      // El borrado también lo coordina el servidor para evitar discrepancias.
      allow delete: if false;
    }
    // Denegar toda otra ruta, incluso para usuarios autenticados.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
