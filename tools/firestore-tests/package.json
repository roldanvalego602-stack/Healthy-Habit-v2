{
  "name": "healthy-habit-firestore-rules-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test rules.test.mjs",
    "test:release": "node --test --test-concurrency=1 rules.test.mjs security_release_gate.test.mjs",
    "test:friends": "node --test --test-name-pattern='amistad|solicitud|amigos' rules.test.mjs",
    "test:lockdown": "HH_RELEASE_PREVIEW=1 node --test --test-concurrency=1 security_release_gate.test.mjs release_preview_positive.test.mjs"
  },
  "dependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "^13.0.0"
  }
}
