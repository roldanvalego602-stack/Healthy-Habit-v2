// CANDIDATA SOLO PARA EMULADOR. No desplegar en producción.
// Aisla la información privada, pero todavía NO soporta ranking/social
// ni impide la manipulación de XP/monedas por el propio propietario.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }
    function owner(uid) {
      return authenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create, update, delete: if owner(uid);

      match /{path=**} {
        allow read, write: if owner(uid);
      }
    }

    match /system/{path=**} {
      allow read: if authenticated();
      allow write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
