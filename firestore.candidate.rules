// CANDIDATA SOLO PARA EMULADOR. No desplegar en producción.
// Aisla la información privada, pero todavía NO soporta ranking/social
// ni impide la manipulación de XP/monedas por el propio propietario.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }
    function owner(uid) {
      return authenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create, update, delete: if owner(uid);

      match /{path=**} {
        allow read, write: if owner(uid);
      }
    }

    // Perfiles para ranking, búsqueda y vistas públicas. Ningún dato privado.
    // El propietario aún controla XP: esto NO certifica un ranking anti-trampas.
    match /public_profiles/{uid} {
      allow get, list: if authenticated();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly([
          'name', 'username', 'photoUrl', 'bio', 'title',
          'xp', 'currentXp', 'level', 'currentStreak', 'streakDays',
          'completedHabits', 'nextLevelXp', 'nextAchievementTitle',
          'nextAchievementProgress', 'settings'
        ])
        && request.resource.data.keys().hasAll(['name', 'username', 'xp'])
        && request.resource.data.name is string
        && request.resource.data.username is string
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.settings is map
        && request.resource.data.settings.keys().hasOnly([
          'mostrarRachaAmigos', 'visibilidadLogros'
        ]);
      allow delete: if owner(uid);
    }

    match /system/{path=**} {
      allow read: if authenticated();
      allow write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
